{
  "name": "tauri-app",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:tauri": "npm run build && tauri build",
    "build:msi": "npm run build && tauri build --bundles msi",
    "build:exe": "npm run build && tauri build --bundles nsis",
    "preview": "vite preview",
    "tauri": "tauri",
    "release": "node release.mjs",
    "build:site": "node scripts/build-site.mjs",
    "updater:latest": "node scripts/generate-latest-json.mjs",
    "deploy:zip": "npm run build && node scripts/create-deploy-zip.mjs",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@types/jszip": "^3.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.63.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "wavesurfer.js": "^8.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "archiver": "^8.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
