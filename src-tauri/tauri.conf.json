{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Worship Tools",
  "version": "1.0.0",
  "identifier": "com.worshiptools.app",
  "build": {
    "beforeDevCommand": {
      "script": "npm run build",
      "wait": true
    },
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "features": ["tauri/custom-protocol"]
  },
  "app": {
    "windows": [
      {
        "title": "Worship Tools",
        "width": 1360,
        "height": 840,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
